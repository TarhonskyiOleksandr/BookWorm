root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,css,scss,html}]
indent_style = space
indent_size = 2

[apps/api/**/*.ts]
indent_style = space
indent_size = 2

[*.{json,yaml,yml,md}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{env,gitignore,npmrc}]
insert_final_newline = false
trim_trailing_whitespace = false
